# Settings for mesh/compose.node.yml. Copy to .env beside that file (or pass
# with --env-file) and edit. Nothing secret belongs here: the certificate
# bundle and the work-signing public key are FILES that the compose file mounts.

# The identity in this node's certificate — must match what node-csr.sh and
# node-sign.sh were given; the ingress rejects a mismatch.
RECEPTOR_NODE_ID=exec-dmz-a

# Both control-plane ingresses as host:port. On the control host, ingress A
# listens on 27199 and B on 27200 (mesh/compose.mesh.yml).
RECEPTOR_PEERS=ctrl.example.com:27199,ctrl.example.com:27200

# Pin a release (tag set in the root README), or run your site-built image
# with extra Python dependencies (mesh/README.md, "Node runtime Python
# dependencies").
#MESH_NODE_IMAGE=ghcr.io/allamiro/ansible-execution-node:latest

# Only if the bundle (tls.crt + tls.key + ca.crt) and the work-signing PUBLIC
# key are not at their defaults beside the compose file:
#   ./secrets/receptor/issued/<node id>/  and  ./secrets/receptor/work-signing/work-public.pem
#MESH_NODE_TLS_DIR=/etc/mesh/exec-dmz-a
#MESH_NODE_WORK_PUBKEY=/etc/mesh/work-public.pem

#RECEPTOR_LOG_LEVEL=info
