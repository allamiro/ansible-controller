#!/bin/bash
# mesh-run — dispatcher (Phases 5+7+8): run a playbook on an execution node
# via receptor, returning the playbook's real exit code and its artifacts —
# with credential hygiene, per-job artifact export, pool dispatch, and the
# dispatch-only failover boundary.
#
#   mesh-run  --node <node-id> | --pool <name> | --zone <name>
#             --playbook <file.yml> --inventory <file> \
#            [--ssh-key <file>] [--socket <receptor.sock>] [--jobs-dir <dir>] \
#            [--log-dir <dir>] [--pools-file <yml>] [--zones-file <yml>]
#
# Runs INSIDE the orchestrator container. Flow — mesh plan §2.4:
#
#   classify (zone -> pool)  -> healthy-node select (routable + free slot)
#   ansible-runner transmit  -> stream the private data dir over stdout
#   receptorctl work submit  -> send it to the node's ansible-runner worktype
#   receptorctl work results -> stream events back as the job runs
#   ansible-runner process   -> reconstruct locally; artifacts + REAL ansible rc
#
# THE FAILOVER BOUNDARY (plan §2.4): failover is dispatch-only. A candidate is
# skipped for the next one ONLY while nothing has left this host — it is not
# routable via any live ingress, or its concurrency slots are all reserved.
# Once one submit is attempted, there is exactly one submission: an ambiguous
# outcome is recorded as such and NEVER re-sent anywhere.
#
# Per-node concurrency (plan §4/UC4) is an atomic flock RESERVATION on a slot
# file held for the life of this process — not a work-list check, so there is
# no check-then-act race, and a crashed dispatcher's slot frees itself when
# the kernel closes the fd. Work signing (--signwork) arrives with Phase 9.
set -euo pipefail

die() { echo "mesh-run: ERROR: $*" >&2; exit 2; }

# --socket takes a comma-separated preference list (Tier 1, §9.7): the first
# socket whose receptor answers `status` is used for the whole job. Both
# sidecars route to every node, so surviving either ingress suffices — losing
# the orchestrator HOST itself is Tier 2 and out of scope here.
NODE= POOL= ZONE= PLAYBOOK= INVENTORY= SSH_KEY= ANSIBLE_CFG= GALAXY_DIR=
SOCKETS=/run/receptor/receptor.sock,/run/receptor/receptor-b.sock
JOBS_DIR=/var/lib/mesh/jobs
SLOTS_DIR="${MESH_SLOTS_DIR:-/var/lib/mesh/slots}"
POOLS_FILE="${MESH_POOLS_FILE:-/etc/mesh/pools.yml}"
# 1 when the operator chose the path (flag or env): a missing file is then an
# error — a typo must never silently disable configured concurrency caps.
POOLS_FILE_SET=0
[ -n "${MESH_POOLS_FILE:-}" ] && POOLS_FILE_SET=1
ZONES_FILE="${MESH_ZONES_FILE:-/etc/mesh/zones.yml}"
# Operator-facing artifact copies land under the controller's log tree — the
# compose setup bind-mounts /var/log/ansible to the host's logs/, so a job's
# stdout/rc/job_events are readable on the host without entering the container
# (plan Phase 7). --log-dir "" disables the export.
LOG_DIR=/var/log/ansible/runner
while [ $# -gt 0 ]; do
  case "$1" in
    --node)        NODE="${2:?}"; shift 2;;
    --pool)        POOL="${2:?}"; shift 2;;
    --zone)        ZONE="${2:?}"; shift 2;;
    --playbook)    PLAYBOOK="${2:?}"; shift 2;;
    --inventory)   INVENTORY="${2:?}"; shift 2;;
    --ssh-key)     SSH_KEY="${2:?}"; shift 2;;
    --ansible-cfg) ANSIBLE_CFG="${2:?}"; shift 2;;
    --galaxy-dir)  GALAXY_DIR="${2:?}"; shift 2;;
    --socket)      SOCKETS="${2:?}"; shift 2;;
    --jobs-dir)    JOBS_DIR="${2:?}"; shift 2;;
    --log-dir)     LOG_DIR="${2-}"; shift 2;;
    --pools-file)  POOLS_FILE="${2:?}"; POOLS_FILE_SET=1; shift 2;;
    --zones-file)  ZONES_FILE="${2:?}"; shift 2;;
    *) die "unknown argument: $1";;
  esac
done
[ -f "$PLAYBOOK" ]  || die "--playbook '$PLAYBOOK' not found"
[ -e "$INVENTORY" ] || die "--inventory '$INVENTORY' not found (file or directory)"
case "$NODE$POOL$ZONE" in '') die "one of --node, --pool, or --zone is required";; esac
{ [ -n "$NODE" ] && { [ -n "$POOL" ] || [ -n "$ZONE" ]; }; } \
  && die "--node is mutually exclusive with --pool/--zone"
{ [ -n "$POOL" ] && [ -n "$ZONE" ]; } && die "--pool and --zone are mutually exclusive"

# (1) classify: a zone names a pool (mesh/config/zones.yml); a pool names an
# ordered candidate list with per-node concurrency caps (pools.yml). Parsed by
# python3+PyYAML (already in the image); a malformed file is a hard error —
# guessing a dispatch target is worse than refusing.
if [ -n "$ZONE" ]; then
  POOL=$(Z_FILE="$ZONES_FILE" Z_NAME="$ZONE" python3 - <<'PYEOF'
import os, sys, yaml
f, zone = os.environ["Z_FILE"], os.environ["Z_NAME"]
try:
    data = yaml.safe_load(open(f)) or {}
except OSError as e:
    sys.exit(f"zones file '{f}': {e}")
except yaml.YAMLError as e:
    sys.exit(f"zones file '{f}' is not valid YAML: {e}")
zones = data.get("zones") or {}
if zone not in zones:
    sys.exit(f"zone '{zone}' not defined in {f}")
entry = zones[zone]
pool = entry if isinstance(entry, str) else (entry or {}).get("pool", "")
if not pool:
    sys.exit(f"zone '{zone}' in {f} names no pool")
print(pool)
PYEOF
) || die "zone classification failed"
fi

# Candidate list: "node cap" per line. --node is a one-entry list; its cap
# still comes from pools.yml when the node is declared there, so the
# concurrency reservation holds however the node was chosen.
# Parsed to a variable FIRST so the producer's exit status gates everything:
# a process substitution's failure is invisible to the consuming while-loop,
# and a malformed trailing entry must fail the whole dispatch, not truncate
# the candidate list. The parser also validates the WHOLE file's cap
# consistency: slot files are per node, shared by every pool, so one node
# declared with two different caps would let dispatches through different
# pools overshoot both.
CANDIDATES=()
if [ -n "$POOL" ]; then
  pool_lines=$(P_FILE="$POOLS_FILE" P_NAME="$POOL" python3 - <<'PYEOF'
import os, sys, yaml
f, pool = os.environ["P_FILE"], os.environ["P_NAME"]
try:
    data = yaml.safe_load(open(f)) or {}
except OSError as e:
    sys.exit(f"pools file '{f}': {e}")
except yaml.YAMLError as e:
    sys.exit(f"pools file '{f}' is not valid YAML: {e}")
pools = data.get("pools") or {}

def parse(pname, e):
    node = e if isinstance(e, str) else (e or {}).get("node", "")
    cap = 0 if isinstance(e, str) else int((e or {}).get("max_concurrent") or 0)
    if not node:
        sys.exit(f"pool '{pname}' has an entry without a node id")
    if cap < 0:
        sys.exit(f"pool '{pname}' node '{node}': max_concurrent must be >= 0")
    return node, cap

caps = {}
for pname, entries in pools.items():
    if entries is not None and not isinstance(entries, list):
        sys.exit(
            f"pool '{pname}' must be a LIST of node entries — a mapping here "
            "(missing '- ' markers) would be iterated as its key names")
    for e in entries or []:
        node, cap = parse(pname, e)
        if node in caps and caps[node][0] != cap:
            sys.exit(
                f"node '{node}' declared with max_concurrent={caps[node][0]} "
                f"in pool '{caps[node][1]}' but {cap} in pool '{pname}' — a "
                "node's cap is global (slot files are shared across pools)")
        caps.setdefault(node, (cap, pname))

if pool not in pools:
    sys.exit(f"pool '{pool}' not defined in {f}")
entries = pools[pool] or []
if not entries:
    sys.exit(f"pool '{pool}' is empty in {f}")
for e in entries:
    node, cap = parse(pool, e)
    print(f"{node} {cap}")
PYEOF
  ) || die "pool resolution failed"
  while IFS= read -r line; do
    [ -n "$line" ] && CANDIDATES+=("$line")
  done <<<"$pool_lines"
  [ ${#CANDIDATES[@]} -gt 0 ] || die "pool '$POOL' resolved to no candidates"
else
  # A cap declared for this node in pools.yml binds --node dispatches too. An
  # ABSENT default pools file means "no caps configured" (backward
  # compatible); but a pools file that exists yet cannot be parsed, or an
  # explicitly passed path that is missing, is a hard error — silently
  # treating a corrupt config as "uncapped" would defeat the cap it declares.
  cap=$(P_FILE="$POOLS_FILE" P_NODE="$NODE" P_EXPLICIT="$POOLS_FILE_SET" python3 - <<'PYEOF'
import os, sys, yaml
f, node = os.environ["P_FILE"], os.environ["P_NODE"]
explicit = os.environ["P_EXPLICIT"] == "1"
try:
    data = yaml.safe_load(open(f)) or {}
except FileNotFoundError:
    if explicit:
        sys.exit(f"pools file '{f}' not found")
    data = {}
except OSError as e:
    sys.exit(f"pools file '{f}': {e}")
except yaml.YAMLError as e:
    sys.exit(f"pools file '{f}' is not valid YAML: {e}")
found = None
for pname, entries in (data.get("pools") or {}).items():
    if entries is not None and not isinstance(entries, list):
        sys.exit(f"pool '{pname}' must be a LIST of node entries")
    for e in entries or []:
        if isinstance(e, str):
            n, cap = e, 0
        else:
            n, cap = (e or {}).get("node", ""), int((e or {}).get("max_concurrent") or 0)
        if n != node:
            continue
        if cap < 0:
            sys.exit(f"pool '{pname}' node '{node}': max_concurrent must be >= 0")
        if found is not None and found[0] != cap:
            sys.exit(
                f"node '{node}' declared with max_concurrent={found[0]} in "
                f"pool '{found[1]}' but {cap} in pool '{pname}' — a node's "
                "cap is global (slot files are shared across pools)")
        found = (cap, pname)
print(found[0] if found else 0)
PYEOF
) || die "pools lookup failed"
  CANDIDATES=("$NODE $cap")
fi

# Live-ingress inventory, once: an ingress can answer `status` while it has
# lost (or is still reconverging) its route to a node the OTHER ingress still
# sees, so routability is judged per candidate against every live socket.
declare -A SOCK_ST
LIVE_SOCKETS=()
IFS=',' read -ra socket_list <<<"$SOCKETS"
for cand in "${socket_list[@]}"; do
  cand="${cand//[[:space:]]/}"
  [ -S "$cand" ] || continue
  st=$(receptorctl --socket "$cand" status 2>/dev/null) || continue
  LIVE_SOCKETS+=("$cand"); SOCK_ST["$cand"]="$st"
done
[ ${#LIVE_SOCKETS[@]} -gt 0 ] || die "no live receptor control socket among: $SOCKETS"

routable_via() {
  local n="$1" s
  for s in "${LIVE_SOCKETS[@]}"; do
    if awk -v n="$n" '$1 == n { found = 1 } END { exit !found }' <<<"${SOCK_ST[$s]}"; then
      printf '%s\n' "$s"; return 0
    fi
  done
  return 1
}

# Atomic per-node concurrency reservation (plan §4): try each numbered slot
# file with a non-blocking flock; the acquired fd is held (deliberately never
# closed) for the life of this process, so the reservation outlives any crash
# exactly as long as the process does and releases the instant it dies.
SLOT_FD= SLOT_FILE= DISPATCH_STATE=pre-submit
acquire_slot() {
  local node="$1" cap="$2" i f
  [ "$cap" -gt 0 ] || return 0   # uncapped node
  (umask 077 && mkdir -p "$SLOTS_DIR") || return 1
  for ((i = 1; i <= cap; i++)); do
    f="$SLOTS_DIR/$node.slot.$i"
    # A .hold marker means a previous dispatch through this slot ended with
    # the job's fate UNKNOWN (ambiguous submit / broken results stream): the
    # acknowledged unit may still be running on the node, so the slot stays
    # reserved even though that dispatcher — and its flock — are gone. The
    # operator clears the marker after confirming the unit finished.
    [ -e "$f.hold" ] && continue
    # The braces are load-bearing: a bare `exec {fd}>>file 2>/dev/null` makes
    # BOTH redirections permanent in this shell — silencing the script's own
    # stderr (including the completion line) for the rest of its life. The
    # group scopes the stderr silence to the open attempt alone, while the
    # exec'd fd itself still persists, which is the point.
    if ! { exec {SLOT_FD}>>"$f"; } 2>/dev/null; then SLOT_FD=; continue; fi
    if flock -n "$SLOT_FD" 2>/dev/null; then SLOT_FILE="$f"; return 0; fi
    { exec {SLOT_FD}>&-; } 2>/dev/null || true
    SLOT_FD=
  done
  return 1
}

# Called on the paths where the submission was (or may have been) accepted
# but this dispatcher can no longer observe it. The flock dies with this
# process; the marker keeps the slot reserved until a human confirms the
# unit's fate — capacity guarantees must not evaporate with the dispatcher.
persist_slot_hold() {
  [ -n "$SLOT_FILE" ] || return 0
  printf 'job=%s unit=%s node=%s\nclear with: rm %s.hold  (after confirming the unit finished)\n' \
    "$JOB_ID" "${UNIT_ID:-unknown}" "$NODE" "$SLOT_FILE" > "$SLOT_FILE.hold" 2>/dev/null \
    || echo "mesh-run: warning: could not persist slot hold $SLOT_FILE.hold — the node's cap may be under-enforced until the unit is confirmed done" >&2
}

# (2) healthy-node select. Skipping a candidate is allowed ONLY here, where
# nothing has left this host — that is the entire dispatch-only failover
# boundary. The trace of skipped candidates is kept for the failure record.
SOCKET= SELECT_NOTE=
for entry in "${CANDIDATES[@]}"; do
  n="${entry% *}" c="${entry##* }"
  case "$n" in *[!A-Za-z0-9._-]*|'') die "node id '$n' invalid";; esac
  s=$(routable_via "$n") || { SELECT_NOTE+="$n: not routable via any live ingress; "; continue; }
  acquire_slot "$n" "$c" || { SELECT_NOTE+="$n: all $c slots reserved; "; continue; }
  NODE="$n" SOCKET="$s"
  break
done

# (4) unique private data dir per job — no shared state between concurrent
# runs. Owner-only from birth (umask, not chmod-after): the staged tree holds
# credentials from the instant the key is copied in, so there must be no
# window in which another uid could read it.
JOB_ID=$(cat /proc/sys/kernel/random/uuid)
PDD="$JOBS_DIR/$JOB_ID"
(umask 077 && mkdir -p "$PDD/project" "$PDD/inventory" "$PDD/env")

# Credential hygiene (plan Phase 7): the staged key copy exists only for the
# transmit stream. Whatever path this dispatcher exits by — success, pre-gate
# refusal, ambiguous submit, broken results stream — the transient copy is
# removed; artifacts and meta.json are kept, the secret is not. shred adds a
# best-effort overwrite before unlinking, but on CoW/journaled/flash storage
# (overlayfs, btrfs, most SSDs) old blocks can survive an overwrite — the
# guarantees that actually hold everywhere are the 0600/0700 scoping from
# birth and prompt removal; put --jobs-dir on a tmpfs when the storage below
# it gets imaged or snapshotted. NEVER enable xtrace in this script and never
# echo the key path's contents — the no-log guarantee is part of the contract.
# Every step is ||-guarded and the incoming exit status is captured and
# restored: a cleanup failure (say the jobs filesystem went read-only) warns
# but must never replace the playbook's exit code — the same
# never-corrupt-the-result rule the artifact export follows.
finalize() {
  local st=$?
  # A reserved slot whose job is in flight must survive ANY exit — die()
  # paths, and catchable signals (TERM/INT are trapped to exit so this trap
  # runs). DISPATCH_STATE is 'in-flight' from the moment a submit attempt
  # starts until the artifacts' rc proves the unit finished.
  if [ "${DISPATCH_STATE:-}" = in-flight ]; then
    persist_slot_hold
  fi
  if [ -n "$SSH_KEY" ] && [ -f "$PDD/env/ssh_key" ]; then
    shred -u "$PDD/env/ssh_key" 2>/dev/null \
      || rm -f "$PDD/env/ssh_key" 2>/dev/null \
      || echo "mesh-run: warning: could not remove transient key copy $PDD/env/ssh_key" >&2
  fi
  # The lifecycle record reaches the host-visible log tree on EVERY terminal
  # path, not just completed round-trips: submit-ambiguous and
  # results-incomplete are exactly the states where an operator needs the
  # record to decide whether re-running is safe.
  if [ -n "$LOG_DIR" ] && [ -f "$PDD/meta.json" ]; then
    { mkdir -p "$LOG_DIR/$JOB_ID" \
        && cp "$PDD/meta.json" "$LOG_DIR/$JOB_ID/meta.json"; } 2>/dev/null \
      || echo "mesh-run: warning: could not export meta.json to '$LOG_DIR/$JOB_ID'; the record remains at $PDD/meta.json" >&2
  fi
  return "$st"
}
trap finalize EXIT
# Catchable signals must route through the EXIT trap: an untrapped TERM would
# skip finalize, releasing an in-flight job's slot and skipping meta export.
trap 'exit 143' TERM
trap 'exit 130' INT
# The playbook is resolved through symlinks ONCE, and that resolved name is
# used for both staging and execution — staging the target directory while
# telling the runner to execute the symlink's basename would fail when the
# alias name does not exist inside the target directory.
PLAYBOOK_REAL=$(readlink -f "$PLAYBOOK") || die "cannot resolve --playbook '$PLAYBOOK'"
# The playbook's DIRECTORY is the project root: roles/, templates/, files/ and
# task includes resolve relative to the playbook, so staging the lone YAML file
# would strand those dependencies on the controller and fail on the node.
cp -a "$(dirname "$PLAYBOOK_REAL")/." "$PDD/project/"
# Keep the inventory's basename: YAML inventory plugins verify by filename
# suffix (e.g. *.aws_ec2.yml), so renaming to "hosts" would reject valid
# plugin inventories after staging. An inventory SOURCE that reads sibling
# files (like configs/inventory/inventory.py loading its neighbours) must be
# passed as its DIRECTORY, which is staged whole.
if [ -d "$INVENTORY" ]; then
  cp -a "$INVENTORY/." "$PDD/inventory/"
else
  cp "$INVENTORY" "$PDD/inventory/$(basename "$INVENTORY")"
fi
# The node has no /configs mount and never ran the controller entrypoint, so a
# playbook relying on the repo's ansible.cfg must SHIP it: --ansible-cfg stages
# it as the project-root ansible.cfg, which ansible loads from the runner's
# cwd. A cfg already present in the playbook's own directory wins — refusing to
# overwrite it beats silently changing a project's declared behaviour.
#
# Absolute paths INSIDE the cfg (a known_hosts under ssh_args, vault password
# files, ...) are a contract with the NODE's environment, not stageable per
# job: this dispatcher cannot know which referenced files are secrets, nor
# rewrite the cfg's paths safely. Provision such files on the node (or its
# site image) at the paths the cfg names — the same rule as runtime Python
# deps. Phase 6/7 bring the mesh's own host-key and credential handling.
# Galaxy content installed at runtime (configs/requirements.yml ->
# /configs/.galaxy) lives only on the controller; the node cannot resolve it.
# --galaxy-dir stages that directory's roles/ and collections/ into the project
# root, where ansible's adjacent-to-playbook search paths find them without any
# path configuration. Local and Galaxy content MERGE per entry — a project with
# its own roles/ can still pull distinct Galaxy roles — and only a same-name
# clash refuses, because silently shadowing either copy would change behaviour.
#
# Python packages a plugin/collection needs at RUNTIME (pip-requirements.txt,
# e.g. boto3 for amazon.aws) are NOT a per-job concern and are not staged: they
# belong in the node image — extend it site-locally the same way the controller
# bakes its deps (FROM execution-node + pip install -r), tracked in the plan's
# Phase 7 checklist.
if [ -n "$GALAXY_DIR" ]; then
  [ -d "$GALAXY_DIR" ] || die "--galaxy-dir '$GALAXY_DIR' is not a directory"
  # merge_tree SRC DST DEPTH: copy per entry, descending DEPTH levels before
  # collision-checking. Roles collide at roles/<name> (depth 1); collections
  # nest as collections/ansible_collections/<namespace>/<name>, so the check
  # must descend to the collection itself (depth 3) — a shared wrapper or
  # namespace directory is expected, not a clash.
  merge_tree() {
    local src="$1" dst="$2" depth="$3" entry name
    mkdir -p "$dst"
    for entry in "$src"/* "$src"/.[!.]*; do
      [ -e "$entry" ] || continue
      name=$(basename "$entry")
      if [ "$depth" -gt 1 ] && [ -d "$entry" ] && [ -d "$dst/$name" ]; then
        merge_tree "$entry" "$dst/$name" $((depth - 1))
      elif [ -e "$dst/$name" ]; then
        die "'${dst#"$PDD/project/"}/$name' exists in both the playbook directory and --galaxy-dir; resolve the clash rather than letting one silently shadow the other"
      else
        cp -a "$entry" "$dst/$name"
      fi
    done
  }
  [ -d "$GALAXY_DIR/roles" ]       && merge_tree "$GALAXY_DIR/roles"       "$PDD/project/roles"       1
  [ -d "$GALAXY_DIR/collections" ] && merge_tree "$GALAXY_DIR/collections" "$PDD/project/collections" 3
fi
if [ -n "$ANSIBLE_CFG" ]; then
  [ -f "$ANSIBLE_CFG" ] || die "--ansible-cfg '$ANSIBLE_CFG' not found"
  if [ -e "$PDD/project/ansible.cfg" ]; then
    die "the playbook directory already ships its own ansible.cfg; refusing to overwrite it"
  fi
  cp "$ANSIBLE_CFG" "$PDD/project/ansible.cfg"
fi
if [ -n "$SSH_KEY" ]; then
  [ -f "$SSH_KEY" ] || die "--ssh-key '$SSH_KEY' not found"
  # env/ssh_key is loaded into a per-job ssh-agent by the runner ON THE NODE
  # and travels only inside the mTLS receptor stream — it is never an argument,
  # never in the environment, never logged (Phase 7). The staged copy here is
  # removed on exit by the trap above; the node-side copy is destroyed by
  # mesh-worker itself right after execution — independent of controller
  # connectivity, so an ambiguous submit or broken results stream cannot
  # strand a key in the unit dir — and `work release` later removes the
  # already-credential-free unit dir.
  install -m 600 "$SSH_KEY" "$PDD/env/ssh_key"
fi

# (5) one meta.json PER JOB — concurrency-safe by construction (plan §4), and
# the hook Tier 2.5 recovery needs later. Status transitions are whole-file
# rewrites of a private file, so there is no shared-file race. Values are
# JSON-encoded properly (a playbook name carrying a quote or newline must not
# yield an unparseable lifecycle record).
# Written to a temp file and renamed, so a concurrent status reader (or an
# interrupted dispatcher) never observes a truncated/partial record. The
# optional second argument is a free-text note for states that need context —
# notably the ambiguous-submit path, where the unit id is genuinely unknown.
meta() {
  M_JOB="$JOB_ID" M_NODE="$NODE" M_POOL="$POOL" M_PB="$(basename "$PLAYBOOK")" \
  M_UNIT="${UNIT_ID:-}" M_ST="$1" M_NOTE="${2:-}" python3 - > "$PDD/meta.json.tmp" <<'PYEOF'
import json, os
rec = {
    "job_id": os.environ["M_JOB"],
    "node": os.environ["M_NODE"],
    "pool": os.environ["M_POOL"],
    "playbook": os.environ["M_PB"],
    "unit_id": os.environ["M_UNIT"],
    "status": os.environ["M_ST"],
    # RFC 3339 UTC; refreshed on every transition so a history reader can
    # order lifecycle records without trusting file mtimes.
    "updated": __import__("datetime").datetime.now(
        __import__("datetime").timezone.utc
    ).isoformat(timespec="seconds"),
}
if os.environ["M_NOTE"]:
    rec["note"] = os.environ["M_NOTE"]
print(json.dumps(rec))
PYEOF
  mv "$PDD/meta.json.tmp" "$PDD/meta.json"
}
meta created

# DEFINITIVELY-pre-submit gate (plan §2.4): the selection above already looked
# for the node on EVERY live ingress (exact first-column match — grep -w would
# treat '-' as a boundary and '.' as a wildcard). No live ingress routing to
# the node means nothing can have been submitted, so failing here may honestly
# say "nothing was executed" — the only place that claim is allowed.
if [ -z "$SOCKET" ]; then
  meta submit-failed-pre "${SELECT_NOTE:-no candidate was selectable}"
  if [ -n "$POOL" ]; then
    die "no healthy node with a free slot in pool '$POOL' (${SELECT_NOTE% }) — nothing was executed"
  fi
  die "node '$NODE' is not reachable via any live ingress ($SOCKETS)${SELECT_NOTE:+ (${SELECT_NOTE% })} — nothing was executed"
fi

# (6) transmit -> submit. receptorctl prints "Unit ID: <id>" on success. Past
# this point failures are AMBIGUOUS: the request may have reached the node and
# the unit may be running even though the response was lost. Per the failover
# boundary (plan §2.4), an ambiguous failure is recorded as such and is NEVER
# treated as "nothing ran" — and this dispatcher never resubmits anywhere.
meta submitting
DISPATCH_STATE=in-flight
submit_out=$(ansible-runner transmit "$PDD" -p "$(basename "$PLAYBOOK_REAL")" 2>/dev/null \
  | receptorctl --socket "$SOCKET" work submit ansible-runner \
      --node "$NODE" --payload -) \
  || { meta submit-ambiguous "unit id unknown: the response was lost after the attempt left this host; inspect 'receptorctl work list' for an unmatched unit"; \
       die "work submit to '$NODE' failed AFTER the attempt left this host — \
the unit MAY BE RUNNING; check 'receptorctl work list' before re-running (job=$JOB_ID)"; }
UNIT_ID=$(awk '/^Unit ID:/ {print $3}' <<<"$submit_out")
[ -n "$UNIT_ID" ] || { meta submit-ambiguous "submit returned but no unit id was parseable; inspect 'receptorctl work list'"; \
  die "no unit id in submit output — state unknown, \
check 'receptorctl work list' before re-running: $submit_out"; }
meta running

# (7)(8) stream results -> process. ansible-runner process replays the play
# output, materialises artifacts under $PDD/artifacts/ (stdout, rc,
# job_events/), and exits with the PLAYBOOK's rc. The unit is released
# explicitly only AFTER results were fully fetched — `submit --rm` could
# release it before retrieval.
rc=0
receptorctl --socket "$SOCKET" work results "$UNIT_ID" 2>/dev/null \
  | ansible-runner process "$PDD" || rc=$?

# The Processor treats a poisoned/empty stream as status=error but still exits
# 0, so "rc==0" alone cannot be trusted: require the artifacts' own rc file,
# written only when the stream round-trip actually completed.
art_rc_file=$(find "$PDD/artifacts" -maxdepth 2 -name rc -type f 2>/dev/null | head -1)
if [ -z "$art_rc_file" ]; then
  # NOT "failed": the unit was acknowledged and the stream broke — the job may
  # well still be running to completion on the node. The status says exactly
  # that, so a history reader does not mistake a dropped connection for a
  # playbook failure (and nobody "retries" a possibly-succeeding job).
  meta results-incomplete "no rc artifact returned; the unit was acknowledged and may still be running — check 'receptorctl work status $UNIT_ID'"
  die "results stream did not complete — the job MAY STILL BE RUNNING on '$NODE' (unit=$UNIT_ID); check 'receptorctl work status $UNIT_ID'; its concurrency slot stays reserved via ${SLOT_FILE:+$SLOT_FILE.hold}${SLOT_FILE:- (node uncapped)}"
fi
rc=$(cat "$art_rc_file")
# The artifacts' own rc proves the unit ran to completion: the slot may now
# die with this process, and finalize must not persist a hold for it.
DISPATCH_STATE=complete

receptorctl --socket "$SOCKET" work release "$UNIT_ID" >/dev/null 2>&1 || true

if [ "$rc" -eq 0 ]; then meta succeeded; else meta "failed rc=$rc"; fi

# Publish the operator-facing artifact set to the log tree (Phase 7): stdout,
# rc, status, job_events plus the final meta.json — the files an operator
# reads — copied per job to $LOG_DIR/<job-id>/, which the compose setup
# exposes on the host as logs/runner/<job-id>/. Runs after the terminal meta
# transition so the exported record shows the job's outcome, and deliberately
# non-fatal: the round-trip SUCCEEDED by this point, and a read-only/absent
# log tree must not convert a completed job into a failure. env/ (credentials)
# is never part of the export.
# Every individual copy is failure-tolerant: under set -e a bare cp dying
# mid-export (disk full, quota) would override the playbook's exit code —
# the one thing this script promises never to do.
if [ -n "$LOG_DIR" ]; then
  art_dir=$(dirname "$art_rc_file")
  export_ok=1
  if mkdir -p "$LOG_DIR/$JOB_ID" 2>/dev/null; then
    for f in stdout rc status; do
      [ -f "$art_dir/$f" ] || continue
      cp "$art_dir/$f" "$LOG_DIR/$JOB_ID/$f" 2>/dev/null || export_ok=0
    done
    if [ -d "$art_dir/job_events" ]; then
      cp -a "$art_dir/job_events" "$LOG_DIR/$JOB_ID/" 2>/dev/null || export_ok=0
    fi
    # meta.json itself is exported by the EXIT trap on every terminal path.
  else
    export_ok=0
  fi
  [ "$export_ok" = 1 ] || echo "mesh-run: warning: artifact export to '$LOG_DIR/$JOB_ID' incomplete; authoritative copies remain at $PDD/artifacts" >&2
fi

echo "mesh-run: job=$JOB_ID node=$NODE unit=$UNIT_ID rc=$rc artifacts=$PDD/artifacts" >&2

# (9) the playbook's own exit code is the contract
exit "$rc"
