FROM ubuntu:26.04
LABEL org.opencontainers.image.title="Ansible Controller"
LABEL org.opencontainers.image.authors="Tamir Suliman <tsuliman@linuxvaults.com>"

ENV DEBIAN_FRONTEND=noninteractive

# ---- packages ----
# upgrade first so base-image packages (openssl, libssl3t64, ...) get security patches
# Ansible itself comes from pip below — NOT the apt `ansible` meta-package, which is
# ~280 MiB of bundled community collections and pins an old ansible-core.
# host keys generated by openssh-server postinst are removed: baking private keys into
# the image ships the same keys to every consumer; entrypoint.sh generates them at runtime
# /usr/bin/pebble is Canonical's service manager, dropped into the OCI rootfs outside dpkg
# (no package owns it, so `apt-get upgrade` can never patch it). This image runs
# entrypoint.sh + sshd as PID 1 and never invokes pebble, so it is dead weight carrying the
# Go stdlib CVEs of whatever toolchain built it (v1.26.5: CVE-2026-33818, CVE-2026-39821,
# CVE-2026-46600, CVE-2026-56853, CVE-2026-56858/9, CVE-2026-56860, CVE-2026-56862).
RUN apt-get update \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      openssh-server \
      git \
      vim-tiny \
      python3 \
      python3-pip \
      sudo \
 && rm -f /etc/ssh/ssh_host_* \
 && rm -rf /usr/bin/pebble /var/lib/pebble \
 && rm -rf /var/lib/apt/lists/*

# ---- ansible-core via pip ----
# pip ships the current patched ansible-core (~8 MiB vs apt ansible's ~280 MiB) and
# its deps (jinja2, PyYAML, ...) at current releases instead of Ubuntu's 2024 pins.
# cryptography floor covers CVE-2026-69247 / CVE-2026-69249 / GHSA-537c-gmf6-5ccf.
# --break-system-packages: required by PEP 668 (Python 3.14 marks system env as externally managed).
# --ignore-installed: apt packages have no pip RECORD file, so pip cannot uninstall them;
#   this skips the uninstall step and writes the new version to /usr/local/lib (higher sys.path priority).
# dnspython/netaddr/jmespath/passlib: controller-side deps of common plugins in
# the baked collections (community.general.dig, json_query, ipaddr-style filters,
# password_hash) that the apt ansible bundle used to pull in as hard dependencies.
# pywinrm/requests-ntlm: manage Windows hosts over WinRM (kerberos transport
# needs extra system libs — declare via configs/pip-requirements.txt instead).
# ansible-lint: `make lint` / lint playbooks in place.
# mitogen: opt-in fast strategy plugin (see the commented block in ansible.cfg).
# msgpack: not a direct dependency — installed at the patched release so the next
#   layer can re-vendor it into pip's bundled copy (GHSA-6v7p-g79w-8964).
RUN pip3 install --upgrade --no-cache-dir --break-system-packages --ignore-installed \
      pip \
      setuptools \
      wheel \
      ansible-core \
      "cryptography>=50.0.0" \
      dnspython \
      netaddr \
      jmespath \
      passlib \
      pywinrm \
      requests-ntlm \
      ansible-lint \
      "mitogen>=0.3.50" \
      "msgpack>=1.2.1"

# ---- patch pip's vendored dependency tree ----
# pip bundles its own copies of a few libraries under pip/_vendor and describes them in
# vendor.txt plus bom.cdx.json, so scanners report those pins independently of what is
# actually installed. patch-pip-vendor.py re-vendors msgpack from the patched release
# installed above (GHSA-6v7p-g79w-8964) and deletes the vendored pkg_resources tree
# (CVE-2025-47273 — dead code on Python 3.14+), keeping both manifests truthful; it
# asserts the result, so a pip release that reshapes _vendor fails the build instead of
# silently reintroducing the findings.
#
# The apt python3-pip is purged rather than patched: it carries a second, older vendored
# tree and is fully shadowed by the /usr/local pip installed above. entrypoint.sh still
# resolves `pip3` to /usr/local/bin/pip3 for /configs/pip-requirements.txt.
COPY docker/patch-pip-vendor.py /tmp/patch-pip-vendor.py
RUN set -eux; \
    apt-get purge -y python3-pip; \
    rm -rf /var/lib/apt/lists/*; \
    python3 /tmp/patch-pip-vendor.py; \
    rm -f /tmp/patch-pip-vendor.py; \
    python3 -c 'from pip._vendor.cachecontrol import serialize'; \
    pip3 --version

# ---- Mitogen strategy plugin on Ansible's default search path ----
# Symlinking into /usr/share/ansible/plugins/strategy (searched by default)
# means enabling Mitogen is just `strategy = mitogen_linear` in ansible.cfg —
# no interpreter-version-specific path to hardcode anywhere.
RUN mkdir -p /usr/share/ansible/plugins \
 && target="$(python3 -c 'import ansible_mitogen, os; print(os.path.join(os.path.dirname(ansible_mitogen.__file__), "plugins", "strategy"))')" \
 && test -d "$target" \
 && ln -s "$target" /usr/share/ansible/plugins/strategy

# ---- baked Galaxy collections ----
# Only the essentials most playbooks touch; everything else is declared in
# configs/requirements.yml and lands in /configs/.galaxy at container start
# (see entrypoint.sh) or via `make galaxy` — no image rebuild needed.
RUN ansible-galaxy collection install ansible.posix community.general \
      -p /usr/share/ansible/collections

# ---- user, dirs, ssh host keys ----
# ubuntu:26.04 base ships a pre-created 'ubuntu' user at UID 1000; remove it first.
RUN userdel -r ubuntu \
 && useradd -u 1000 -m -s /bin/bash ansible \
 && mkdir -p /home/ansible/.ssh /configs /var/log/ansible /var/run/sshd \
 && chown -R ansible:ansible /home/ansible /configs /var/log/ansible

RUN printf 'Defaults:ansible !requiretty\nansible ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/99-ansible \
 && chmod 440 /etc/sudoers.d/99-ansible

# ---- entrypoint and runtime ---
# SSH host keys are intentionally NOT generated here — entrypoint.sh creates them
# on first start so each deployment gets unique keys. They live in
# /etc/ssh/host_keys (a dedicated dir the compose file persists as a volume)
# so sshd_config and moduli keep tracking the image across updates.
RUN mkdir -p /etc/ssh/host_keys /etc/ssh/sshd_config.d \
 && printf 'HostKey /etc/ssh/host_keys/ssh_host_rsa_key\nHostKey /etc/ssh/host_keys/ssh_host_ecdsa_key\nHostKey /etc/ssh/host_keys/ssh_host_ed25519_key\n' \
      > /etc/ssh/sshd_config.d/10-host-keys.conf
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD bash -c 'exec 6<>/dev/tcp/127.0.0.1/22'

EXPOSE 22
CMD ["/usr/local/bin/entrypoint.sh"]
